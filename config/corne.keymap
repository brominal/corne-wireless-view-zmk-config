#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <39 19>;
        };

        left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <38 16>;
        };

        toggle_arrow_layer {
            bindings = <&mo 2>;
            key-positions = <38 13>;
        };

        toggle_pairs_layer {
            bindings = <&mo 3>;
            key-positions = <39 22>;
        };
    };

    behaviors {
        f_num: f_num {
            compatible = "zmk,behavior-hold-tap";
            label = "F_NUM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lyrs: lyrs {
            compatible = "zmk,behavior-tap-dance";
            label = "LYRS";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "qwerty";
            bindings = <
&none  &kp Q  &kp W  &kp E             &kp R         &kp T    &kp Y      &kp U    &kp I          &kp O    &kp P     &none
&none  &kp A  &kp S  &kp D             &kp F         &kp G    &kp H      &kp J    &kp K          &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C             &kp V         &kp B    &kp N      &kp M    &kp COMMA      &kp DOT  &kp FSLH  &none
                     &kp LEFT_CONTROL  &kp LEFT_GUI  &lyrs    &kp SPACE  &kp TAB  &kp RIGHT_ALT
            >;
        };

        num_mod {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "num_mod";
            bindings = <
&none  &none         &none         &kp TAB           &kp ESCAPE      &kp DEL      &kp GRAVE      &f_num F7 N7  &f_num F8 N8  &f_num F9 N9  &none                 &none
&none  &kp CAPS      &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ENTER    &none          &f_num F4 N4  &f_num F5 N5  &f_num F6 N6  &kp SINGLE_QUOTE      &none
&none  &kp LEFT_GUI  &none         &none             &none           &none        &none          &f_num F1 N1  &f_num F2 N2  &f_num F3 N3  &kp NON_US_BACKSLASH  &none
                                   &none             &none           &none        &kp BACKSPACE  &none         &kp N0
            >;
        };

        arrows {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "arrows";
            bindings = <
&none  &none  &none             &none         &none         &none    &none     &none     &none         &none      &none  &none
&none  &none  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &none  &none
&none  &none  &none             &none         &none         &none    &none     &none     &none         &none      &none  &none
                                &none         &none         &none    &none     &none     &none
            >;
        };

        pairs {
            bindings = <
&none  &none  &none         &none      &none                 &none               &none              &none                  &none      &none            &none  &none
&none  &none  &kp C_VOL_DN  &kp MINUS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp C_VOLUME_UP  &none  &none
&none  &none  &kp K_MUTE    &none      &kp LEFT_BRACE        &none               &none              &kp RIGHT_BRACE        &none      &none            &none  &none
                            &none      &none                 &kp BACKSPACE       &kp SPACE          &none                  &none
            >;

            label = "pairs";
        };
    };
};
