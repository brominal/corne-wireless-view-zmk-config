#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <39 19>;
        };

        left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <38 16>;
        };

        left_enter {
            bindings = <&kp RETURN>;
            key-positions = <38 17>;
        };

        right_enter {
            bindings = <&kp RETURN>;
            key-positions = <39 18>;
        };

        enter_mouse_layer {
            bindings = <&tog 4>;
            key-positions = <13 22>;
        };
    };

    macros {
        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(V)>;
            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X)>;
            label = "CUT";
        };
    };

    behaviors {
        copy_paste: copy_paste {
            compatible = "zmk,behavior-tap-dance";
            label = "COPY_PASTE";
            #binding-cells = <0>;
            bindings = <&copy>, <&paste>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "qwerty";
            bindings = <
&none  &kp Q    &kp W  &kp E             &kp R         &kp T    &kp Y      &kp U    &kp I          &kp O    &kp P       &none
&none  &lt 2 A  &kp S  &kp D             &kp F         &kp G    &kp H      &kp J    &kp K          &kp L    &lt 3 SEMI  &none
&none  &kp Z    &kp X  &kp C             &kp V         &kp B    &kp N      &kp M    &kp COMMA      &kp DOT  &kp FSLH    &none
                       &kp LEFT_CONTROL  &kp LEFT_GUI  &mo 1    &kp SPACE  &kp TAB  &kp RIGHT_ALT
            >;
        };

        num_mod {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "num_mod";
            bindings = <
&none  &none         &none         &kp TAB           &kp ESCAPE      &kp DEL      &kp GRAVE      &none   &none   &none  &none                 &none
&none  &kp CAPS      &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ENTER    &none          &none   &none   &none  &kp SINGLE_QUOTE      &none
&none  &kp LEFT_GUI  &none         &none             &kp LEFT_SHIFT  &none        &none          &none   &none   &none  &kp NON_US_BACKSLASH  &none
                                   &trans            &trans          &none        &kp BACKSPACE  &trans  &kp N0
            >;
        };

        arrows {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "arrows";
            bindings = <
&none  &none  &none             &none         &none         &none             &kp GRAVE  &kp F     &none          &none      &none  &none
&none  &none  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT    &kp LEFT   &kp DOWN  &kp UP_ARROW   &kp RIGHT  &none  &none
&none  &none  &none             &none         &none         &none             &none      &none     &none          &none      &none  &none
                                &trans        &trans        &none             &none      &trans    &kp RIGHT_ALT
            >;
        };

        pairs {
            bindings = <
&none  &none  &none         &none      &kp C_BRIGHTNESS_DEC  &none               &none              &kp C_BRIGHTNESS_INC   &none          &none            &none  &none
&none  &none  &kp C_VOL_DN  &kp MINUS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp EQUAL      &kp C_VOLUME_UP  &none  &none
&none  &none  &kp K_MUTE    &none      &kp LEFT_BRACE        &none               &none              &kp RIGHT_BRACE        &none          &none            &none  &none
                            &trans     &trans                &kp BACKSPACE       &kp SPACE          &trans                 &kp RIGHT_ALT
            >;

            label = "pairs";
        };

        mouse {
            bindings = <
&none  &none  &none  &mkp MB4   &mkp MB5   &cut      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
&none  &none  &none  &mkp LCLK  &mkp RCLK  &copy     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none  &none  &none  &none      &none      &paste    &none           &none           &none         &none            &none  &none
                     &trans     &trans     &trans    &trans          &trans          &trans
            >;

            label = "mouse";
        };
    };
};
